#
# SmartGrid public reference environment template.
# Copy to .env and replace every CHANGE_ME_* value before running docker compose.
#

# Core secrets
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARE_TUNNEL_TOKEN

# Dashboard/Postgres
POSTGRES_USER=smartgrid
POSTGRES_PASSWORD=CHANGE_ME_DASHBOARD_POSTGRES_PASSWORD
POSTGRES_DB=smartgrid
POSTGRES_DSN=******postgres-dashboard:5432/smartgrid?sslmode=disable

# Auth service/admin
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=CHANGE_ME_AUTH_DB_PASSWORD
AUTH_DB_NAME=auth_db
AUTH_POSTGRES_DSN=******postgres-auth:5432/auth_db?sslmode=disable
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_EMAIL=admin@example.invalid
AUTH_ADMIN_PASSWORD=CHANGE_ME_AUTH_ADMIN_PASSWORD

# Module MariaDB
MODULE_DB_NAME=module_db
MODULE_DB_USER=module_user
MODULE_DB_ROOT_PASSWORD=CHANGE_ME_MODULE_DB_ROOT_PASSWORD
MODULE_DB_PASSWORD=CHANGE_ME_MODULE_DB_PASSWORD
MODULE_DB_DSN=module_user:CHANGE_ME_MODULE_DB_PASSWORD@tcp(mariadb-module:3306)/module_db?parseTime=true&charset=utf8mb4

# TimescaleDB
TIMESCALE_DB_USER=module_user
TIMESCALE_DB_PASSWORD=CHANGE_ME_TIMESCALE_DB_PASSWORD
TIMESCALE_DB_NAME=module_ts
TIMESCALE_DSN=******timescaledb-module:5432/module_ts?sslmode=disable

# MQTT (use empty values when broker auth is disabled)
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_URL=tcp://mosquitto:1883

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# Optional app settings (safe placeholders)
NATS_URL=nats://nats:4222
MODBUS_IP=127.0.0.1
MODBUS_PORT=502
WEATHER_LAT=0
WEATHER_LON=0
SSID=CHANGE_ME_NON_PRODUCTION_SSID
